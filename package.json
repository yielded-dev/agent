{
  "name": "effect-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "tooling/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "ci:version": "changeset version && vp install --ignore-scripts",
    "verify:package-purity": "bun scripts/verify-package-purity.ts",
    "admin:durable": "node --experimental-transform-types scripts/durable-admin.ts",
    "docs:dev": "vp run -F @yielded/agent-docs dev",
    "docs:build": "vp run -F @yielded/agent-docs build",
    "docs:preview": "vp run -F @yielded/agent-docs preview",
    "check": "vp check && vp run typecheck && vp run check:exports && vp run check:record-format && vp run check:deploy && bun scripts/verify-package-purity.ts",
    "check:exports": "bun scripts/verify-package-exports.ts",
    "test": "vp run -r --parallel --concurrency-limit 4 test",
    "build": "vp run -r build && vp run action:build",
    "ready": "vp run check && vp run test && vp run build",
    "check:record-format": "bun scripts/verify-record-format.ts",
    "typecheck": "vp run -F './packages/*' -F './examples/*' -F './tooling/*' -F './docs' --concurrency-limit 1 check && vp run check:scripts",
    "check:scripts": "effect-tsrs diagnostics --type-check --project scripts/tsconfig.json",
    "check:docs": "tsrs --noEmit -p docs/tsconfig.json"
  },
  "devDependencies": {
