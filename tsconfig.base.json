{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["span", "untraced"],
        "allowedUnstableApis": [
          "@effect/ai-anthropic",
          "@effect/ai-openai",
          "@effect/ai-openai-compat",
          "@effect/ai-typesafe",
          "@effect/atom-react",
          "@effect/platform-browser",
          "@effect/platform-bun",
          "@effect/platform-node",
          "@effect/sql-pg",
          "@effect/sql-sqlite-do",
          "@effect/sql-sqlite-node/SqliteClient",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/ByteSize",
          "effect/ConfigProvider#fromDotEnv",
          "effect/Crypto",
          "effect/Effect#withErrorReporting",
          "effect/ErrorReporter",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/ai",
          "effect/cli",
          "effect/cluster",
          "effect/encoding/Yaml#parse",
          "effect/http",
          "effect/http-api",
          "effect/observability",
          "effect/process",
          "effect/reactivity",
          "effect/rpc",
          "effect/socket",
          "effect/sql",
          "effect/workflow"
        ],
        "diagnosticSeverity": {
          "unknownRuleName": "error",
          "effectFnOpportunity": "warning",
          "catchIfTagToCatchTag": "warning",
          "catchRefailToTapError": "warning",
          "flatMapIgnoredParamToAndThen": "warning",
          "allOfMapToForEach": "warning",
          "anyUnknownInErrorContext": "warning",
          "catchAllTagDispatchToCatchTag": "warning",
          "catchConditionalRefailToCatchIf": "warning",
          "flatMapConditionalToFilterOrFail": "warning",
          "instanceOfSchema": "suggestion",
          "nestedEffectGenYield": "suggestion",
          "newSchemaClass": "error",
          "optionMatchToFromOption": "warning",
          "preferSchemaTypeProperty": "suggestion",
          "preferTypedSchemaDecoder": "warning",
          "provideLayerSucceedToProvideService": "warning",
          "runOfExitToRunExit": "warning",
          "timeoutCatchTagToTimeoutOrElse": "warning",
          "unsafeEffectTypeAssertion": "warning",
          "floatingEffect": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "extendsNativeError": "error"
        },
        "overrides": [
          {
            "include": ["packages/**/*", "../packages/**/*", "../../packages/**/*"],
            "options": {
              "namespaceImportPackages": ["effect", "@effect/*"],
              "diagnosticSeverity": {
                "preferNamespaceImport": "error"
              }
            }
          },
          {
            "include": ["**/src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "warning",
                "preferSchemaOverJson": "suggestion"
              }
            }
          }
        ]
      }
    ]
  }
}
