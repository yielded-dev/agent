# Your host owns /auth/*, the HttpOnly access cookie, accounts and permissions.
AUTH_ISSUER=https://auth.example.com
AUTH_RESOURCE=https://planner.example.com
AUTH_JWKS_URL=https://auth.example.com/jwks
AUTH_REQUIRED_SCOPE=planner
AUTH_HOSTED_MODEL_SCOPE=hosted-model
# Credential for the host's private /internal/agent/access permission check.
AUTH_YIELDED_CLIENT_SECRET=

# Base64-encoded 32-byte encryption secret for BYOK. Persist between deployments.
BYOK_ENCRYPTION_KEY=
# Optional model key. The auth host must explicitly authorize every hosted request.
SERVER_OPENAI_KEY=
