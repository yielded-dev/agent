# One canonical HTTPS origin; GitHub callback is AUTH_ORIGIN/travel/auth/github/callback.
AUTH_ORIGIN=https://agent.yielded.dev
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_YIELDED_ISSUER=https://auth.yielded.dev
AUTH_YIELDED_CLIENT_SECRET=
# Optional, operator-verified links to existing active GitHub accounts. Apply before first Yielded sign-in.
AUTH_YIELDED_ACCOUNT_LINKS=[]

# Cloudflare Email Sending binding; domain must be onboarded to Email Service.
# The binding needs no email API key. Use a sender on your verified domain.
AUTH_EMAIL_FROM=

# Three independent base64url-encoded 32-byte secrets. Persist between deployments.
AUTH_BINDING_KEY=
AUTH_PROOF_KEY=
AUTH_TRANSACTION_KEY=

# Base64-encoded 32-byte encryption secret for BYOK. Persist between deployments.
BYOK_ENCRYPTION_KEY=

# Optional server funding for explicitly allowlisted accounts. Never exposed to browsers.
SERVER_OPENAI_KEY=
