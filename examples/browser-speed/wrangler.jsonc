{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "effect-agent-browser-speed",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app lives under /browser-use; unmatched paths reach the Worker, which redirects "/".
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/browser-use/api/*"],
  },
  "browser": { "binding": "BROWSER", "remote": true },
  "durable_objects": { "bindings": [{ "name": "LAB", "class_name": "BrowserLab" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrowserLab"] }],
  "observability": { "enabled": false },
  "env": {
    // Public lab at agent.yielded.dev/browser-use: visitor keys, rate-limited runs. Travel
    // planner accounts on its allowlist (same origin, so the same session) run on FUNDED_* keys.
    "public": {
      "name": "yielded-agent-browser-use",
      "workers_dev": false,
      // The bare root redirects to the lab; nothing else is served on agent.yielded.dev yet.
      "routes": [
        { "pattern": "agent.yielded.dev/", "zone_name": "yielded.dev" },
        { "pattern": "agent.yielded.dev/browser-use*", "zone_name": "yielded.dev" },
      ],
      "vars": { "LAB_PUBLIC": "true" },
      "browser": { "binding": "BROWSER", "remote": true },
      "durable_objects": {
        "bindings": [
          { "name": "LAB", "class_name": "BrowserLab" },
          {
            "name": "AUTH",
            "class_name": "PlannerAuth",
            "script_name": "effect-agent-travel-planner",
          },
        ],
      },
      "ratelimits": [
        { "name": "RUN_LIMIT", "namespace_id": "4401", "simple": { "limit": 6, "period": 60 } },
      ],
    },
  },
}
