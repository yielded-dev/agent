{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "effect-agent-browser-speed",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // The app lives under /browser-use; unmatched paths reach the Worker, which redirects "/".
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/browser-use/api/*"],
  },
  "browser": { "binding": "BROWSER", "remote": true },
  "worker_loaders": [{ "binding": "LOADER" }],
  "r2_buckets": [{ "binding": "TRACES", "bucket_name": "effect-agent-browser-traces" }],
  "durable_objects": { "bindings": [{ "name": "LAB", "class_name": "BrowserLab" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrowserLab"] }],
  "observability": { "enabled": false },
  "version_metadata": { "binding": "VERSION" },
}
