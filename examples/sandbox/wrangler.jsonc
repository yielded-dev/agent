{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yielded-agent-sandbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "agent.yielded.dev/sandbox*", "zone_name": "yielded.dev" },
    { "pattern": "*.sandbox-preview.yielded.dev/*", "zone_name": "yielded.dev" },
  ],
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "THREADS", "class_name": "CodingThread" },
      { "name": "WORKSPACES", "class_name": "AccountWorkspaces" },
      { "name": "SANDBOXES", "class_name": "CodingSandbox" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CodingThread", "CodingSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountWorkspaces"] },
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "yielded-agent-sandbox-workspaces" }],
  "containers": [
    {
      "name": "yielded-agent-sandbox",
      "class_name": "CodingSandbox",
      "scheduling_policy": "durable_object",
      "images": { "harness": { "dockerfile": "./container/Dockerfile" } },
    },
  ],
  "ratelimits": [
    { "name": "RUN_LIMIT", "namespace_id": "4403", "simple": { "limit": 6, "period": 60 } },
  ],
  "observability": { "enabled": true },
  "vars": {
    "AUTH_ISSUER": "https://auth.yielded.dev",
    "AUTH_RESOURCE": "https://agent.yielded.dev",
    "AUTH_JWKS_URL": "https://auth.yielded.dev/oauth/yielded/jwks",
    "AUTH_REQUIRED_SCOPE": "agent:sandbox",
    "AUTH_HOSTED_MODEL_SCOPE": "agent:hosted-model",
    "SANDBOX_MAX_INSTANCES": "4",
    "PREVIEW_DOMAIN": "sandbox-preview.yielded.dev",
  },
}
