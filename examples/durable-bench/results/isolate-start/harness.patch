+import { BunRuntime, BunServices } from "@effect/platform-bun";
+import { Console, Effect, Schema } from "effect";
+
+import { Cloudflare } from "./cloudflare.ts";
+import { deployments } from "./deploy.ts";
+
+const program = Effect.gen(function* () {
+  const names = yield* Schema.decodeUnknownEffect(
+    Schema.NonEmptyArray(Schema.String.check(Schema.isPattern(/^isolate-start-[a-z0-9-]+$/))),
+  )(process.argv.slice(2));
+  const deploy = yield* deployments;
+  for (const name of names)
+    yield* Console.log(JSON.stringify({ name, cleanup: yield* deploy.destroy(name) }));
