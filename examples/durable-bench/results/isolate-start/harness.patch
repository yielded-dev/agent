+import { readFile } from "node:fs/promises";
+import { dirname } from "node:path";
+
+import { BunRuntime, BunServices } from "@effect/platform-bun";
+import { Console, Effect, FileSystem } from "effect";
+import type { Plugin } from "esbuild";
+
+import { build } from "./build.ts";
+import { hash, save } from "./platform.ts";
+
+const edits: { file: string; beforeSha256: string; afterSha256: string }[] = [];
+
+const annotate: Plugin = {
+  name: "isolate-start-two-pure-unions",
+  setup(bundler) {
+    bundler.onLoad(
+      { filter: /packages\/effect-agent\/src\/core\/(AgentError|RunEvent)\.ts$/ },
+      async ({ path }) => {
+        const name = path.endsWith("AgentError.ts") ? "AgentError" : "RunEvent";
+        const before = await readFile(path, "utf8");
+        const needle = `export const ${name} = Schema.Union([`;
+
+        if (before.split(needle).length !== 2)
+          throw new Error("Expected exactly one native schema union");
+
+        const after = before.replace(
+          needle,
+          `export const ${name} = /* @__PURE__ */ Schema.Union([`,
+        );
+
+        edits.push({
+          file: `packages/effect-agent/src/core/${name}.ts`,
+          beforeSha256: hash(before),
+          afterSha256: hash(after),
+        });
+
+        return { contents: after, loader: "ts", resolveDir: dirname(path) };
+      },
+    );
+  },
+};
+
+const program = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const directory = "/private/tmp/isolate-start-analysis/pure-unions-deployed";
+  const baseline = yield* build(`${directory}/baseline`, "yielded", "07f0272e");
+  const candidate = yield* build(`${directory}/candidate`, "yielded", "07f0272e", [annotate]);
+
+  if (edits.length !== 2) return yield* Effect.die("Both source annotations must be applied");
+  for (const [label, source] of [
+    ["baseline", baseline],
+    ["candidate", candidate],
+  ] as const)
+    yield* fs.copyFile(source.file, `/private/tmp/isolate-start-analysis/pure-unions-${label}.mjs`);
+  yield* save(`${directory}/manifest.json`, {
+    baseline,
+    candidate,
+    edits,
+    sourceRevision: "07f0272e",
+    virtualSourceOnly: true,
+  });
+  yield* Console.log(JSON.stringify({ baseline, candidate, edits }));
+});
+
+BunRuntime.runMain(program.pipe(Effect.provide(BunServices.layer)));
