new file mode 100644
--- /dev/null
+++ b/examples/durable-bench/deployed/startup-compare.ts
@@ -0,0 +1,73 @@
+import { join } from "node:path";
+
+import { BunRuntime, BunServices } from "@effect/platform-bun";
+import { Console, Effect, FileSystem, Schema } from "effect";
+
+import { Cloudflare } from "./cloudflare.ts";
+import { deployments } from "./deploy.ts";
+import { hash, nonce, privateDirectory, save, workspace } from "./platform.ts";
+
+const program = Effect.gen(function* () {
+  const { label, file, baseline, pi, blocks, namespaceMode } = yield* Schema.decodeUnknownEffect(
+    Schema.Struct({
+      label: Schema.NonEmptyString,
+      file: Schema.NonEmptyString,
+      baseline: Schema.NonEmptyString,
+      pi: Schema.NonEmptyString,
+      blocks: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 30 })),
+      namespaceMode: Schema.Literals(["startup", "native"]),
+    }),
+  )({
+    label: process.argv[2],
+    file: process.argv[3],
+    baseline: process.argv[4] ?? "/private/tmp/isolate-start-analysis/baseline.mjs",
+    pi: process.argv[5] ?? "/private/tmp/isolate-start-analysis/pi.mjs",
+    blocks: Number(process.argv[6] ?? 4),
+    namespaceMode: process.argv[7] ?? "startup",
+  });
+
+  const fs = yield* FileSystem.FileSystem;
+  const deploy = yield* deployments;
+  const run = nonce().slice(0, 8);
+  const builds = new Map<string, string>();
+
+  for (const source of [baseline, file, pi]) builds.set(source, hash(yield* fs.readFile(source)));
+  yield* save(`${workspace}/results/isolate-start-startup-${run}.json`, {
+    label,
+    run,
+    builds: [...builds].map(([path, sha256]) => ({ file: path.split("/").at(-1), sha256 })),
+    order: `ABBA repeated ${blocks} times; pi after each block`,
+    namespaceMode,
+    distinctCodeBytes: true,
+  });
+  for (let block = 0; block < blocks; block++) {
+    for (const [index, source] of [baseline, file, file, baseline, pi].entries()) {
+      const target = source === pi ? "pi" : "yielded";
+      const name = source === baseline ? "baseline" : source === pi ? "pi" : label;
+      const revision = `compare-${run}-${name}-${builds.get(source)}-${block}-${index}`;
+      const directory = join(privateDirectory, `startup-${run}`, `${block}-${index}`);
+      const uploaded = join(directory, "worker.mjs");
+
+      yield* fs.makeDirectory(directory, { recursive: true, mode: 0o700 });
+      yield* fs.writeFileString(
+        uploaded,
+        `// isolate-start upload: ${revision}\n${yield* fs.readFileString(source)}`,
+        { mode: 0o600 },
+      );
+
+      yield* deploy.target(
+        `isolate-start-upload-${target}`,
+        uploaded,
+        revision,
+        false,
+        namespaceMode === "native" ? target : `startup-${target}`,
+        false,
+      );
+      yield* Console.log(`Uploaded ${name}, block ${block + 1}/${blocks}, position ${index + 1}/5`);
+    }
+  }
+});
+
+BunRuntime.runMain(
+  program.pipe(Effect.provide(Cloudflare.layer), Effect.provide(BunServices.layer)),
+);
