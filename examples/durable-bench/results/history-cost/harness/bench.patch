+/** Setup-only canonical import. Timed builds always export the production ThreadObject. */
+import { DurableObject } from "cloudflare:workers";
+
+import { Host } from "./host.ts";
+import type { Env } from "./protocol.ts";
+import { exportRows, importRows, snapshotDigest } from "./storage.ts";
+
+export { agent, definitions } from "./yielded.ts";
+
+export class YieldedDO extends DurableObject<Env> {
+  private readonly host: Host;
+  constructor(ctx: DurableObjectState, env: Env) {
+    super(ctx, env);
+    this.host = new Host(ctx, env, "yielded");
+  }
+  override fetch(request: Request): Promise<Response> {
+    return this.host.fetch(request, {
+      import: async (fixture, query) => {
+        if (
+          fixture.mode !== "import" ||
+          !fixture.thread ||
+          !fixture.snapshotDigest ||
+          fixture.destination !== query.object
+        )
+          throw new Error("Offline setup requires an addressed, canonically imported snapshot");
+        if ((await snapshotDigest(fixture.thread)) !== fixture.snapshotDigest)
+          throw new Error("Fixture snapshot transport digest mismatch");
+        importRows(this.ctx.storage, fixture.thread);
+        if ((await snapshotDigest(exportRows(this.ctx.storage))) !== fixture.snapshotDigest)
+          throw new Error("Restored SQLite snapshot differs from its verified source");
+      },
+    });
+  }
+  override alarm(): never {
+    throw new Error("A quiesced fixture must not have a running maintenance alarm");
+  }
+}
