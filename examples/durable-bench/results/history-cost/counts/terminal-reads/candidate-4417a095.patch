diff --git a/packages/storage-sql/src/SqlThreadNativeReads.ts b/packages/storage-sql/src/SqlThreadNativeReads.ts
index 22ee61ab..a2e0975f 100644
--- a/packages/storage-sql/src/SqlThreadNativeReads.ts
+++ b/packages/storage-sql/src/SqlThreadNativeReads.ts
@@ -1078,11 +1078,23 @@ export const makeSelectedReads = Effect.fnUntraced(function* (
           if (request.throughSequence > tail.tail_sequence)
             return yield* failure("prompt read is ahead of canonical tail");
 
+          // Keep the earliest terminal fact in this requested prefix. A later Submission
+          // settlement cannot change its Run's prompt coverage or compaction timing.
+          const terminalMembership = sql`(record_tag<>'SubmissionSettled' OR run_id IS NULL OR NOT EXISTS (
+            SELECT 1 FROM ${relation("effect_agent_canonical_records")} AS terminal ${recoveryIndex(sql, "effect_agent_records_call")}
+            WHERE terminal.thread_id=effect_agent_canonical_records.thread_id
+              AND terminal.run_id=effect_agent_canonical_records.run_id
+              AND terminal.record_tag IN ('RunCompleted', 'RunFailed')
+              AND terminal.sequence>${request.afterSequence ?? 0}
+              AND terminal.sequence<effect_agent_canonical_records.sequence
+          ))`;
+
           // Bound raw hydration before the narrow decoder discards large non-prompt fields.
           const plan = yield* decodePromptPlan(
             yield* sql`SELECT sequence, ${promptRecordBytes} AS record_json_bytes
             FROM ${relation("effect_agent_canonical_records")} ${recoveryIndex(sql, "effect_agent_records_prompt")}
             WHERE thread_id=${request.threadId} AND ${sql.literal(SQL_PROMPT_PREDICATE)}
+              AND ${terminalMembership}
               AND sequence>${request.afterSequence ?? 0} AND sequence<=${request.throughSequence}
             ORDER BY sequence LIMIT ${request.limit}`.pipe(execute),
           );
@@ -1117,6 +1129,7 @@ export const makeSelectedReads = Effect.fnUntraced(function* (
               yield* sql`SELECT thread_id, sequence, record_id, ${recordJson} AS record_json
               FROM ${relation("effect_agent_canonical_records")} ${recoveryIndex(sql, "effect_agent_records_prompt")}
               WHERE thread_id=${request.threadId} AND ${sql.literal(SQL_PROMPT_PREDICATE)}
+                AND ${terminalMembership}
                 AND sequence>=${page[0].sequence} AND sequence<=${page[page.length - 1].sequence}
               ORDER BY sequence`.pipe(execute),
             );
